{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://full-video-pipeline/animations/comparison-grid.schema.json",
  "title": "ComparisonGrid instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["extras"],
  "properties": {
    "$schema": {"type": "string"},
    "instanceId": {"type": "string"},
    "theme": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/theme"},
    "global": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/global"},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^cell-[0-5]-[0-5]$"},
          "text": {"type": ["string", "null"]},
          "color": {"type": ["string", "null"]},
          "delay": {"type": ["number", "null"], "minimum": 0, "maximum": 60000},
          "duration": {"type": ["number", "null"], "minimum": 1, "maximum": 60000},
          "easing": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/easingName"},
          "hidden": {"type": "boolean", "default": false},
          "custom": {"type": "object"}
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1, "maximum": 6},
        "cols": {"type": "integer", "minimum": 1, "maximum": 6},
        "cells": {
          "type": "array", "minItems": 0, "maxItems": 36,
          "items": {"type": "array", "items": {"type": "string"}}
        },
        "eyebrow": {"type": ["string", "null"], "default": null},
        "title": {"type": ["string", "null"], "default": null},
        "subtitle": {"type": ["string", "null"], "default": null},
        "sequenceOrder": {"type": "string", "enum": ["rowMajor", "diagonal", "spiral"], "default": "diagonal"},
        "flipDurationSeconds": {"type": "number", "minimum": 0.2, "maximum": 2, "default": 0.42},
        "staggerSeconds": {"type": "number", "minimum": 0, "maximum": 3, "default": 0.07},
        "cellGapPx": {"type": "number", "minimum": 0, "maximum": 80, "default": 8},
        "cellBackground": {"type": ["string", "null"], "default": null},
        "cellBorder": {"type": ["string", "null"], "default": null},
        "cellRadiusPx": {"type": "number", "minimum": 0, "maximum": 60, "default": 10},
        "cellPaddingPx": {"type": "number", "minimum": 0, "maximum": 200, "default": 24},
        "headerCellPaddingPx": {"type": "number", "minimum": 0, "maximum": 200, "default": 16},
        "headerRowRatio": {"type": "number", "minimum": 0.3, "maximum": 1.5, "default": 0.7},
        "flipEasing": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/easingName"},
        "headerRow": {"type": "boolean", "default": false},
        "headerEmphasis": {"type": "string", "enum": ["none", "fill", "border", "both"], "default": "none"},
        "accentLandFlash": {"type": "boolean", "default": true},
        "rowSeparators": {"type": "boolean", "default": false},
        "winnerRow": {"type": ["integer", "null"], "minimum": 0, "maximum": 5, "default": null},
        "winnerRowDurationFrames": {"type": "integer", "minimum": 4, "maximum": 120, "default": 14},
        "cellBorderless": {"type": "boolean", "default": false},
        "postFlipHoldFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 18},
        "containerWidthPct": {"type": "number", "minimum": 50, "maximum": 100, "default": 88},
        "containerHeightPct": {"type": "number", "minimum": 30, "maximum": 100, "default": 64},
        "columnWidths": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0.05, "maximum": 10}, "maxItems": 6},
        "columnAlign": {"type": ["array", "null"], "items": {"type": "string", "enum": ["left", "center", "right"]}, "maxItems": 6}
      }
    }
  }
}