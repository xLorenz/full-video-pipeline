{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://full-video-pipeline/animations/right-wrong-card.schema.json",
  "title": "RightWrongCard instance",
  "description": "Per-template schema for right-wrong-card. All TemplateConfig core fields (theme/global/elements/instanceId/$schema) are $ref'd from the global animations.schema.json; extras.* and element.custom.* specific to this template are extended here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["extras"],
  "properties": {
    "$schema": {"type": "string"},
    "instanceId": {"type": "string"},
    "theme": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/theme"},
    "global": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/global"},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["left-label", "left-body", "right-label", "right-body", "verdict-stamp"]
          },
          "text": {"type": ["string", "null"]},
          "delay": {"type": ["number", "null"], "minimum": 0, "maximum": 60000},
          "duration": {"type": ["number", "null"], "minimum": 1, "maximum": 60000},
          "easing": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/easingName"},
          "position": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/element/properties/position"},
          "size": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fontSize": {"type": ["number", "null"], "minimum": 4, "maximum": 1000},
              "scale": {"type": ["number", "null"], "minimum": 0.05, "maximum": 20}
            }
          },
          "color": {"type": ["string", "null"]},
          "hidden": {"type": "boolean", "default": false},
          "custom": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verdictColor": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "leftIsWinner": {
          "type": "boolean",
          "description": "DEPRECATED — use cards[].verdict instead. Still accepted for backwards-compat; absent when extras.cards is supplied."
        },
        "stampStyle": {"type": "string", "enum": ["stamp", "shake", "glow", "none"], "default": "stamp"},
        "stampGlyph": {"type": "string", "default": ""},
        "stampForce": {"type": "number", "minimum": 0, "maximum": 2, "default": 1},
        "cardPaddingPx": {"type": "number", "minimum": 0, "maximum": 200, "default": 48},
        "cardGapPx": {"type": "number", "minimum": 0, "maximum": 400, "default": 64},
        "cornerRadiusPx": {"type": "number", "minimum": 0, "maximum": 200, "default": 24},
        "cardElevationPx": {"type": "number", "minimum": 0, "maximum": 32, "default": 16},
        "loserDesaturate": {"type": "boolean", "default": true},
        "loserShrink": {"type": "number", "minimum": 0.1, "maximum": 1.5, "default": 0.92},
        "loserFade": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.55},
        "winnerBorderWidthPx": {"type": "number", "minimum": 0, "maximum": 8, "default": 3},
        "watermarkGlyphPx": {"type": "number", "minimum": 80, "maximum": 800, "default": 380},
        "watermarkOpacity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.22},
        "preEnterHoldFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 12},
        "postVerdictHoldFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 30},
        "cardGradient": {"type": "boolean", "default": true},
        "winnerGlowPx": {"type": "number", "minimum": 0, "maximum": 96, "default": 40},
        "winnerGlowColor": {"type": ["string", "null"], "default": null},
        "loserShadowTint": {"type": "boolean", "default": true},
        "impactFlash": {"type": "boolean", "default": true},
        "impactFlashPeak": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.85},
        "cards": {
          "type": "array",
          "description": "Per-card spec. If absent, legacy leftIsWinner + elements[] is synthesized.",
          "items": {
            "type": "object",
            "required": ["id", "verdict"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "verdict": {"type": "string", "enum": ["win", "lose", "none"]},
              "placement": {"type": ["string", "number", "null"]},
              "label": {"type": ["string", "null"]},
              "body": {"type": ["string", "null"]},
              "labelColor": {"type": ["string", "null"]},
              "bodyColor": {"type": ["string", "null"]},
              "hidden": {"type": "boolean"},
              "enterDelay": {"type": "number", "description": "extra stagger for this card's slide-in (frames)"},
              "verdictAt": {"type": "number", "description": "frame at which this card's stamp starts — INDEPENDENT per card"},
              "verdictDuration": {"type": "number"},
              "stampGlyph": {"type": "string"},
              "stampStyle": {"type": "string", "enum": ["stamp", "shake", "glow", "none"]},
              "stampForce": {"type": "number", "minimum": 0, "maximum": 2},
              "stampColor": {"type": ["string", "null"]},
              "stampSize": {"type": "number"},
              "stampOpacity": {"type": "number", "minimum": 0, "maximum": 1},
              "winnerBorderWidthPx": {"type": "number", "minimum": 0, "maximum": 10},
              "winnerGlowPx": {"type": "number", "minimum": 0, "maximum": 96}
            }
          }
        }
      }
    }
  }
}