{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://full-video-pipeline/animations/glyph-rain.schema.json",
  "title": "GlyphRainRip instance",
  "description": "Per-template schema for glyph-rain. Core TemplateConfig fields (theme/global) are $ref-d from the global animations.schema.json. This template does NOT own content — it overlays matrix-style glyph rain on top of arbitrary `children` passed by the caller, so `elements[]` is unconstrained (any id) and typically empty. extras.* are extended here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["extras"],
  "properties": {
    "$schema": {"type": "string"},
    "instanceId": {"type": "string"},
    "theme": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/theme"},
    "global": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/global"},
    "elements": {
      "type": "array",
      "description": "Currently unused by glyph-rain itself — content is passed as `children` to <GlyphRainRip>. Kept in the schema for DeepConfig pipeline compatibility.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": ["string", "null"]},
          "delay": {"type": ["number", "null"], "minimum": 0, "maximum": 60000},
          "duration": {"type": ["number", "null"], "minimum": 1, "maximum": 60000},
          "easing": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/easingName"},
          "position": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/element/properties/position"},
          "size": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fontSize": {"type": ["number", "null"], "minimum": 4, "maximum": 1000},
              "scale": {"type": ["number", "null"], "minimum": 0.05, "maximum": 20}
            }
          },
          "color": {"type": ["string", "null"]},
          "hidden": {"type": "boolean", "default": false},
          "custom": {"type": "object"}
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cell": {"type": "integer", "minimum": 8, "maximum": 64, "default": 15},
        "charset": {"type": "string", "minLength": 1, "maxLength": 256, "default": "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789Z*+-<>¦=:."},
        "glyphColor": {"type": "string"},
        "headColor": {"type": "string"},
        "speed": {"type": "number", "minimum": 0.05, "maximum": 3, "default": 0.2},
        "speedVariance": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
        "density": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.15},
        "trail": {"type": "number", "minimum": 0.2, "maximum": 3, "default": 0.65},
        "glow": {"type": "number", "minimum": 0, "maximum": 3, "default": 1.75},
        "mutate": {"type": "number", "minimum": 0, "maximum": 4, "default": 0},
        "flicker": {"type": "number", "minimum": 0, "maximum": 1, "default": 0},
        "layers": {"type": "integer", "minimum": 1, "maximum": 3, "default": 2},
        "dim": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5},
        "columnCountCap": {"type": "integer", "minimum": 8, "maximum": 400, "default": 220},
        "deterministicSeed": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 1},
        "fadeInFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 0},
        "fadeOutFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 0}
      }
    }
  }
}