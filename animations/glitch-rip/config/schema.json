{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://full-video-pipeline/animations/glitch-rip.schema.json",
  "title": "GlitchRip instance",
  "description": "Per-template schema for glitch-rip. Core TemplateConfig fields (theme/global) are $ref-d from the global animations.schema.json. This template does NOT own content — it overlays glitch bursts on top of arbitrary `children` passed by the caller, so `elements[]` is unconstrained (any id) and typically empty. extras.* are extended here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["extras"],
  "properties": {
    "$schema": {"type": "string"},
    "instanceId": {"type": "string"},
    "theme": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/theme"},
    "global": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/global"},
    "elements": {
      "type": "array",
      "description": "Currently unused by glitch-rip itself — content is passed as `children` to <GlitchRip>. Kept in the schema for DeepConfig pipeline compatibility.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": ["string", "null"]},
          "delay": {"type": ["number", "null"], "minimum": 0, "maximum": 60000},
          "duration": {"type": ["number", "null"], "minimum": 1, "maximum": 60000},
          "easing": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/easingName"},
          "position": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/element/properties/position"},
          "size": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fontSize": {"type": ["number", "null"], "minimum": 4, "maximum": 1000},
              "scale": {"type": ["number", "null"], "minimum": 0.05, "maximum": 20}
            }
          },
          "color": {"type": ["string", "null"]},
          "hidden": {"type": "boolean", "default": false},
          "custom": {"type": "object"}
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalSeconds": {"type": "number", "minimum": 0, "maximum": 60, "default": 3},
        "burstDurationSeconds": {"type": "number", "minimum": 0.05, "maximum": 8, "default": 0.5},
        "attackRatio": {"type": "number", "minimum": 0.05, "maximum": 0.8, "default": 0.18},
        "slices": {"type": "integer", "minimum": 3, "maximum": 200, "default": 22},
        "shiftPx": {"type": "number", "minimum": 0, "maximum": 400, "default": 34},
        "rgbShiftPx": {"type": "number", "minimum": 0, "maximum": 120, "default": 8},
        "blocks": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.55},
        "noise": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.4},
        "backgroundColor": {"type": "string"},
        "rowBandMode": {"type": "string", "enum": ["slices", "rows"], "default": "slices"},
        "blocksCellPx": {"type": "integer", "minimum": 24, "maximum": 1024, "default": 120},
        "scanlineEveryRows": {"type": "integer", "minimum": 1, "maximum": 64, "default": 3},
        "scanlineOpacity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.18},
        "grainOpacity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.22},
        "quietFadeFrames": {"type": "integer", "minimum": 0, "maximum": 60, "default": 4},
        "postBurstHoldFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 0},
        "deterministicSeed": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 1}
      }
    }
  }
}