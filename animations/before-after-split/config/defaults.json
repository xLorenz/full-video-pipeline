{
  "instanceId": "before-after-split.defaults",
  "theme": {},
  "global": { "speed": 1.0, "delayOffset": 0, "easing": "ease-out-cubic" },
  "elements": [
    { "id": "before-label", "text": "Before", "hidden": false },
    { "id": "after-label",  "text": "After",  "hidden": false }
  ],
  "extras": {
    "direction": "vertical",
    "sweepDirection": "ltr",
    "panelContentAnchor": "screen-center",
    "sweepDurationSeconds": 1.4,
    "sweepEasing": "ease-in-out",
    "sweepAccentSeconds": 0.32,
    "dividerStyle": "gradient",
    "dividerColor": null,
    "dividerWidthPx": 6,
    "wipeLightWidthPx": 120,
    "beforeColor": null,
    "afterColor": null,
    "panelGradient": true,
    "beforeValue": null,
    "afterValue": null,
    "valueFontPx": 40,
    "labelFontPx": 84,
    "panelPaddingPx": 120,
    "labelOpacityDuringSweep": 0.55,
    "labelFadeInFrames": 12,
    "labelHoldAfterFrames": 12,
    "preSweepHoldFrames": 18,
    "postSweepHoldFrames": 30,
    "sameColorGuard": true
  }
}