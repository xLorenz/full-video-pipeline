{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://full-video-pipeline/animations/before-after-split.schema.json",
  "title": "BeforeAfterSplit instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["extras"],
  "properties": {
    "$schema": {"type": "string"},
    "instanceId": {"type": "string"},
    "theme": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/theme"},
    "global": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/global"},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "enum": ["before-label", "after-label"]},
          "text": {"type": ["string", "null"]},
          "delay": {"type": ["number", "null"], "minimum": 0, "maximum": 60000},
          "duration": {"type": ["number", "null"], "minimum": 1, "maximum": 60000},
          "easing": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/easingName"},
          "color": {"type": ["string", "null"]},
          "hidden": {"type": "boolean", "default": false},
          "custom": {"type": "object"}
        }
      }
    },
    "extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {"type": "string", "enum": ["horizontal", "vertical"], "default": "vertical"},
        "sweepDirection": {"type": "string", "enum": ["ltr", "rtl", "ttb", "btt"], "default": "ltr"},
        "panelContentAnchor": {"type": "string", "enum": ["panel-edge", "screen-center"], "default": "screen-center"},
        "sweepDurationSeconds": {"type": "number", "minimum": 0.3, "maximum": 8, "default": 1.4},
        "sweepEasing": {"$ref": "https://full-video-pipeline/schemas/animations.schema.json#/definitions/easingName"},
        "sweepAccentSeconds": {"type": "number", "minimum": 0, "maximum": 2, "default": 0.32},
        "dividerStyle": {"type": "string", "enum": ["line", "gradient", "glow"], "default": "gradient"},
        "dividerColor": {"type": ["string", "null"], "default": null},
        "dividerWidthPx": {"type": "number", "minimum": 1, "maximum": 32, "default": 6},
        "wipeLightWidthPx": {"type": "number", "minimum": 24, "maximum": 400, "default": 120},
        "beforeColor": {"type": ["string", "null"], "default": null},
        "afterColor": {"type": ["string", "null"], "default": null},
        "panelGradient": {"type": "boolean", "default": true},
        "beforeValue": {"type": ["string", "null"], "default": null},
        "afterValue": {"type": ["string", "null"], "default": null},
        "valueFontPx": {"type": "number", "minimum": 12, "maximum": 120, "default": 40},
        "labelFontPx": {"type": "number", "minimum": 24, "maximum": 160, "default": 84},
        "panelPaddingPx": {"type": "number", "minimum": 0, "maximum": 400, "default": 120},
        "labelOpacityDuringSweep": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.55},
        "labelFadeInFrames": {"type": "integer", "minimum": 1, "maximum": 120, "default": 12},
        "labelHoldAfterFrames": {"type": "integer", "minimum": 0, "maximum": 120, "default": 12},
        "preSweepHoldFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 18},
        "postSweepHoldFrames": {"type": "integer", "minimum": 0, "maximum": 600, "default": 30},
        "sameColorGuard": {"type": "boolean", "default": true}
      }
    }
  }
}