<!--
  Scene sub-composition TEMPLATE.

  Copy this file to `compositions/scene-NN.html` for each scene and customize.
  The file is rendered standalone via:
      npx hyperframes render -c compositions/scene-NN.html --output scenes/scene-NN.mp4

  It is also referenced from index.html via `data-composition-src` so the
  agent can preview the whole assembled video in the browser.

  CLI variables (passed via --variables or --variables-file):
    - title             (string, scene title shown as headline)
    - subtitle          (string, optional secondary text)
    - palette           (object, color overrides; see styles/tokens.css)
    - captions          (array, optional burned-in caption cues)
    - showCaptions      (boolean, gates the captions layer — default false)

  Per-scene duration comes from `data-duration` on the root element below —
  set it from the actual_duration_seconds measured in Step 6.
-->
<template id="scene-template">
  <div
    data-composition-id="scene-01"
    data-composition-variables='[
      {"id":"title","type":"string","label":"Scene title","default":"Scene 01"},
      {"id":"subtitle","type":"string","label":"Subtitle","default":""},
      {"id":"showCaptions","type":"boolean","label":"Burn captions","default":false}
    ]'
    data-width="1920"
    data-height="1080"
    data-start="0"
    data-duration="11.0"
  >
    <!-- Background layer -->
    <div
      id="scene-background"
      class="clip"
      data-start="0"
      data-duration="11.0"
      data-track-index="0"
      style="position: absolute; inset: 0; background: var(--color-background, #0b0f1a);"
    ></div>

    <!-- Headline -->
    <h1
      id="scene-headline"
      class="clip"
      data-start="0.2"
      data-duration="10.8"
      data-track-index="1"
      style="position: absolute; left: 6%; top: 38%; right: 6%;
             font-family: var(--font-headline, 'Inter'), sans-serif;
             font-size: var(--font-headline-size, 120px);
             font-weight: 800; line-height: 1.05;
             color: var(--color-text, #ffffff);"
    ></h1>

    <!-- Subtitle -->
    <p
      id="scene-subtitle"
      class="clip"
      data-start="0.6"
      data-duration="10.4"
      data-track-index="2"
      style="position: absolute; left: 6%; top: 60%; right: 24%;
             font-family: var(--font-body, 'Inter'), sans-serif;
             font-size: var(--font-body-size, 44px);
             font-weight: 400; line-height: 1.3;
             color: var(--color-muted, #9aa6c2);"
    ></p>

    <!-- Optional burned-in captions layer (gated by showCaptions) -->
    <div
      id="scene-captions"
      class="clip"
      data-start="0"
      data-duration="11.0"
      data-track-index="3"
      style="position: absolute; bottom: 96px; left: 0; right: 0;
             display: flex; justify-content: center; align-items: center;
             pointer-events: none; opacity: 0;"
    >
      <div id="caption-pill" style="background: rgba(0,0,0,0.7);
             padding: 16px 36px; border-radius: 18px;
             font-family: var(--font-body, 'Inter'), sans-serif;
             font-size: 44px; font-weight: 700; color: #ffffff;
             max-width: 80%; text-align: center;">
        <span id="caption-text">&nbsp;</span>
      </div>
    </div>

    <style>
      [data-composition-id="scene-01"] {
        position: relative;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
      }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <script>
      (function () {
        // Per-instance variables (declared defaults < passed overrides merged).
        // Read at runtime via the HyperFrames variable accessor.
        const vars = (window.__hyperframes && window.__hyperframes.getVariables)
          ? window.__hyperframes.getVariables()
          : { title: "Scene 01", subtitle: "", showCaptions: false };

        // Bind dynamic text from variables.
        const headline = document.querySelector(
          '[data-composition-id="scene-01"] #scene-headline',
        );
        const subtitle = document.querySelector(
          '[data-composition-id="scene-01"] #scene-subtitle',
        );
        if (headline) headline.textContent = vars.title || "";
        if (subtitle) subtitle.textContent = vars.subtitle || "";

        // Hide captions layer unless explicitly enabled.
        const captions = document.querySelector(
          '[data-composition-id="scene-01"] #scene-captions',
        );
        if (captions && !vars.showCaptions) {
          captions.style.display = "none";
        }

        const tl = gsap.timeline({ paused: true });

        // Headline entrance: fade up from below.
        tl.fromTo(
          '[data-composition-id="scene-01"] #scene-headline',
          { opacity: 0, y: 60 },
          { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" },
          0,
        );

        // Subtitle fade in 0.3s after the headline.
        tl.fromTo(
          '[data-composition-id="scene-01"] #scene-subtitle',
          { opacity: 0, y: 30 },
          { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" },
          0.3,
        );

        // Optional captions sequence — fed via the captions array from
        // scenes.json `captions` cues. Replace this stub with a real cue
        // loop generated at scaffold or per-scene authoring time.
        // (See compositions/scene-NN.html for real per-cue GSAP code.)

        window.__timelines = window.__timelines || {};
        window.__timelines["scene-01"] = tl;
      })();
    </script>
  </div>
</template>
