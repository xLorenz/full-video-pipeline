# Copy to `.env` (gitignored, never commit) and fill in your keys.
# Loaded by the cloud TTS engine scripts on startup (via pl.load_dotenv_file())
# — real environment variables always win.
# Scoped to the deepgram/fish engines only; nothing else in the pipeline reads .env.

# Deepgram Flux TTS (scripts/generate_voiceover_deepgram.py, gitignored engine).
# Get one at https://console.deepgram.com/ — fallback order is:
# voiceover.api_key (per-video config) → DEEPGRAM_API_KEY env → repo-root .env
DEEPGRAM_API_KEY=

# Fish Audio S2.1 TTS (scripts/generate_voiceover_fish.py, gitignored engine).
# Get one at https://fish.audio/ → API Keys — fallback order is:
# voiceover.api_key (per-video config) → FISH_API_KEY env → repo-root .env
# The voice itself is chosen with `voiceover.reference_id` in the per-video
# pipeline_config.json (a Fish voice model id), not here.
FISH_API_KEY=