# Copy to `.env` (gitignored, never commit) and fill in your keys.
# Loaded by scripts/generate_voiceover_deepgram.py on startup
# (via pl.load_dotenv_file()) — real environment variables always win.
# Scoped to the deepgram engine only; nothing else in the pipeline reads .env.

# Deepgram Flux TTS (scripts/generate_voiceover_deepgram.py, gitignored engine).
# Get one at https://console.deepgram.com/ — fallback order is:
# voiceover.api_key (per-video config) → DEEPGRAM_API_KEY env → repo-root .env
DEEPGRAM_API_KEY=
